        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Styling Classes\n    classDef capstone fill:#ffcccb,stroke:#cc0000,stroke-width:2px;\n    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:2px;\n    classDef char fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px;\n    classDef api fill:#d5e8d4,stroke:#82b366,stroke-width:2px;\n    classDef default fill:#f5f5f5,stroke:#666,stroke-width:1px;\n\n    %% Capstone Anchor\n    CAP[\&quot;FinCoach Cloud Student Finance Advisor\&quot;]:::capstone\n    \n    %% Main Branches\n    FUND[\&quot;Cloud Fundamentals\&quot;]\n    EVOL[\&quot;Cloud Evolution and Drivers\&quot;]\n    ARCH[\&quot;Architecture and Deployment\&quot;]\n    SERV[\&quot;Service Models and Responsibility\&quot;]:::service\n    VIRT[\&quot;Virtualization and Web/API Layer\&quot;]:::api\n    SPEC[\&quot;Capstone Connection\&quot;]:::capstone\n\n    %% Anchor Connections\n    CAP --&gt;|relies on| FUND\n    CAP --&gt;|driven by| EVOL\n    CAP --&gt;|structured by| ARCH\n    CAP --&gt;|consumes| SERV\n    CAP --&gt;|communicates through| VIRT\n    CAP --&gt;|implemented as| SPEC\n\n    %% Fundamentals Node\n    FUND --&gt;|defines| Def[\&quot;Definition\&quot;]\n    FUND --&gt;|exhibits| Char[\&quot;Characteristics\&quot;]:::char\n    FUND --&gt;|provides| Ben[\&quot;Benefits\&quot;]\n    FUND --&gt;|has| Lim[\&quot;Limitations\&quot;]\n    Char --&gt;|enables| OD[\&quot;On-demand access\&quot;]:::char\n    Char --&gt;|tracks via| MS[\&quot;Measured service\&quot;]:::char\n\n    %% Evolution Node\n    EVOL --&gt;|started with| HW[\&quot;Hardware evolution\&quot;]\n    EVOL --&gt;|progressed to| SW[\&quot;Internet software evolution\&quot;]\n    EVOL --&gt;|utilizes| DS[\&quot;Distributed systems\&quot;]\n    EVOL --&gt;|optimized by| CE[\&quot;Cost economics\&quot;]\n    EVOL --&gt;|demands| MOB[\&quot;Mobility &amp; Remote access\&quot;]\n    EVOL --&gt;|scales for| BD[\&quot;Big data growth\&quot;]\n\n    %% Architecture Node\n    ARCH --&gt;|UI interaction| FE[\&quot;Front-end\&quot;]\n    ARCH --&gt;|processing| BE[\&quot;Back-end\&quot;]\n    ARCH --&gt;|connects via| NL[\&quot;Network layer\&quot;]\n    ARCH --&gt;|hosted in| DC[\&quot;Data center\&quot;]\n    ARCH --&gt;|managed by| MSW[\&quot;Management software\&quot;]\n    ARCH --&gt;|FinCoach uses| PUB[\&quot;Public cloud\&quot;]\n    ARCH --&gt;|other options| OTH[\&quot;Private/Hybrid/Community\&quot;]\n\n    %% Service Models Node\n    SERV --&gt;|App Storage| IaaS[\&quot;IaaS (Provider/User Responsibility)\&quot;]:::service\n    SERV --&gt;|Backend Hosting| PaaS[\&quot;PaaS (Shared Responsibility)\&quot;]:::service\n    SERV --&gt;|Authentication| SaaS[\&quot;SaaS (Provider Responsibility)\&quot;]:::service\n    SERV --&gt;|Machine Learning| XaaS[\&quot;XaaS\&quot;]:::service\n\n    %% Virtualization Node\n    VIRT --&gt;|runs on| VM[\&quot;Virtual machine &amp; Hypervisor\&quot;]:::api\n    VIRT --&gt;|creates| ABS[\&quot;Abstraction\&quot;]:::api\n    VIRT --&gt;|allows| RP[\&quot;Resource pooling &amp; Multi-tenancy\&quot;]:::api\n    VIRT --&gt;|uses| WS[\&quot;Web services\&quot;]:::api\n    WS --&gt;|modern| REST[\&quot;REST API request/response\&quot;]:::api\n    WS --&gt;|legacy| SOAP[\&quot;SOAP\&quot;]:::api\n\n    %% Capstone Connection Node\n    SPEC --&gt;|Target audience| USR[\&quot;Students\&quot;]:::capstone\n    SPEC --&gt;|Interface| APP[\&quot;Budget App/Module\&quot;]:::capstone\n    SPEC --&gt;|Logic| CBE[\&quot;Node.js Cloud backend\&quot;]:::capstone\n    SPEC --&gt;|Data| CDB[\&quot;Cloud Database/Storage\&quot;]:::capstone\n    SPEC --&gt;|Output| DASH[\&quot;Dashboard/Analytics\&quot;]:::capstone\n    SPEC --&gt;|Handles traffic via| SCALE[\&quot;Scalability and Elasticity\&quot;]:::capstone&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KplL8pW48i3RYJDDDEpa-169">
